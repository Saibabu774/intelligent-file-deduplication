APP_NAME=Intelligent File Deduplication System
ENVIRONMENT=development
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/file_dedup_db
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=5120
ALLOWED_EXTENSIONS=pdf,txt,csv,jpg,jpeg,png,gif,webp,doc,docx,xls,xlsx,ppt,pptx,zip,rar,mp3,mp4
CORS_ORIGINS=http://localhost:5173
